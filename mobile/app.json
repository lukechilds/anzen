{
  "expo": {
    "name": "Anzen",
    "slug": "anzen",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": ["./plugins/withAnzenRuntime"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anzen.wallet",
      "infoPlist": { "NSBluetoothAlwaysUsageDescription": "Anzen uses Bluetooth to reach your hardware signer." }
    },
    "android": { "package": "com.anzen.wallet", "allowBackup": false },
    "web": { "bundler": "metro" }
  }
}
