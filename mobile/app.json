{
  "expo": {
    "name": "Anzen",
    "slug": "anzen",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": ["./plugins/withAnzenRuntime"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anzen.wallet",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Anzen uses Bluetooth to reach your hardware signer.",
        "NSFaceIDUsageDescription": "Anzen uses Face ID to open your wallet, open your vault and approve payments."
      }
    },
    "android": {
      "package": "com.anzen.wallet",
      "allowBackup": false,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#060607" }
    },
    "web": { "bundler": "metro" }
  }
}
