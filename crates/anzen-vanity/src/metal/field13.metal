// dbl-2009-l.
inline JacF jac_double(JacF p) {
    if (p.infinity || f_is_zero(p.y)) return jac_infinity();
    F a = f_sqr(p.x);
    F b = f_sqr(p.y);
    F c = f_sqr(b);
    F d = f_sub(f_sub(f_sqr(f_add(p.x, b)), a), c);
    d = f_add(d, d);
    F e = f_add(f_add(a, a), a);
    JacF r;
    r.x = f_sub(f_sqr(e), f_add(d, d));
    F c8 = f_add(c, c);
    c8 = f_add(c8, c8);
    c8 = f_add(c8, c8);
    r.y = f_sub(f_mul(e, f_sub(d, r.x)), c8);
    F yz = f_mul(p.y, p.z);
    r.z = f_add(yz, yz);
    r.infinity = false;
    return r;
