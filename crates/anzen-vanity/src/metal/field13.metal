// The unique representative below p.
inline F f_canonical(F a) {
    F r = a;
    // Bits 256..259 sit in limb 19 above bit 9: fold them with 2^256 ≡ 2^32 + 977, twice in case
    // the first fold carries back up.
    for (int round = 0; round < 2; round++) {
        uint top = r[19] >> 9;
        r[19] &= 0x1ffu;
        r[0] += top * 977u;
        r[2] += top * 64u;
        uint carry = 0;
        #pragma unroll
        for (int i = 0; i < 20; i++) {
            uint v = r[i] + carry;
            r[i] = v & LIMB_MASK;
            carry = v >> 13;
        }
    }
    // Now r < 2^256 < 2p: subtract p once if r >= p.
    bool at_least_p = true;
    bool decided = false;
    #pragma unroll
    for (int i = 19; i >= 0; i--) {
        if (!decided && r[i] != P13[i]) {
            at_least_p = r[i] > P13[i];
            decided = true;
        }
    }
    if (at_least_p) {
        uint borrow = 0;
        #pragma unroll
        for (int i = 0; i < 20; i++) {
            uint v = r[i] + 8192u - P13[i] - borrow;
            r[i] = v & LIMB_MASK;
            borrow = 1u - (v >> 13);
        }
    }
    return r;
}

inline bool f_is_zero(F a) {
    F r = f_canonical(a);
    uint bits = 0;
    #pragma unroll
    for (int i = 0; i < 20; i++) bits |= r[i];
    return bits == 0;
}

inline F fe_to_f(Fe a) {
    F r;
    #pragma unroll
    for (int i = 0; i < 20; i++) {
        uint bit = 13 * i;
        uint word = bit / 32;
        uint shift = bit % 32;
        uint v = a.v[word] >> shift;
        if (shift > 19 && word < 7) v |= a.v[word + 1] << (32 - shift);
        r[i] = v & LIMB_MASK;
    }
    return r;
}

// A canonical element back to 8 little-endian 32-bit limbs.
inline Fe f_to_fe(F a) {
    Fe r = Fe{{0, 0, 0, 0, 0, 0, 0, 0}};
    #pragma unroll
    for (int i = 0; i < 20; i++) {
        uint bit = 13 * i;
        uint word = bit / 32;
        uint shift = bit % 32;
        r.v[word] |= a[i] << shift;
        if (shift > 19 && word < 7) r.v[word + 1] |= a[i] >> (32 - shift);
    }
    return r;
}

inline F f_one() {
    F r;
    #pragma unroll
    for (int i = 0; i < 20; i++) r[i] = 0;
    r[0] = 1;
    return r;
