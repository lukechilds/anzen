// Jacobian plus affine (madd-2007-bl), with the special cases.
inline JacF jac_add_affine(JacF p, AffF q) {
    if (q.infinity) return p;
    if (p.infinity) return jac_from_affine(q);
    F z1z1 = f_sqr(p.z);
    F u2 = f_mul(q.x, z1z1);
    F s2 = f_mul(q.y, f_mul(p.z, z1z1));
    F h = f_sub(u2, p.x);
    F s_diff = f_sub(s2, p.y);
    if (f_is_zero(h)) {
        if (f_is_zero(s_diff)) return jac_double(p);
        return jac_infinity();
    }
    F hh = f_sqr(h);
    F i = f_add(hh, hh);
    i = f_add(i, i);
    F j = f_mul(h, i);
    F r_ = f_add(s_diff, s_diff);
    F v = f_mul(p.x, i);
    JacF r;
    r.x = f_sub(f_sub(f_sqr(r_), j), f_add(v, v));
    F y1j = f_mul(p.y, j);
    r.y = f_sub(f_mul(r_, f_sub(v, r.x)), f_add(y1j, y1j));
    r.z = f_sub(f_sub(f_sqr(f_add(p.z, h)), z1z1), hh);
    r.infinity = false;
    return r;
}

// acc + k·G from the table: one mixed addition per nonzero window of k.
inline JacF jac_add_mul_g(JacF acc, Fe k, device const uint *g_table) {
    for (uint w = 0; w < G_WINDOWS; w++) {
        uint digit = window_digit(k, w * G_WINDOW_BITS);
        if (digit != 0) {
            uint base = (w * G_DIGITS + digit - 1) * 16;
            Fe qx, qy;
            #pragma unroll
            for (int i = 0; i < 8; i++) {
                qx.v[i] = g_table[base + i];
                qy.v[i] = g_table[base + 8 + i];
            }
            AffF q;
            q.x = fe_to_f(qx);
            q.y = fe_to_f(qy);
            q.infinity = false;
            acc = jac_add_affine(acc, q);
        }
    }
    return acc;
}
