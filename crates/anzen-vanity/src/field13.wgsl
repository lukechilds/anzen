const S_MASK: i32 = 0x1fff;
// p^-1 mod 2^13.
const P_INV13: u32 = 2767u;

struct Transition {
    zeta: i32,
    u: i32,
    v: i32,
    q: i32,
    r: i32,
}

// 13 divsteps on the low bits of f and g (libsecp256k1's branch-free form).
fn divsteps13(zeta_in: i32, f0: u32, g0: u32) -> Transition {
    var zeta = zeta_in;
    var f = f0;
    var g = g0;
    var u = 1u;
    var v = 0u;
    var q = 0u;
    var r = 1u;
    for (var i = 0u; i < 13u; i++) {
        var c1 = bitcast<u32>(zeta >> 31u);
        let c2 = 0u - (g & 1u);
        let x = (f ^ c1) - c1;
        let y = (u ^ c1) - c1;
        let z = (v ^ c1) - c1;
        g += x & c2;
        q += y & c2;
        r += z & c2;
        c1 &= c2;
        zeta = (zeta ^ bitcast<i32>(c1)) - 1;
        f += g & c1;
        u += q & c1;
        v += r & c1;
        g >>= 1u;
        u <<= 1u;
        v <<= 1u;
    }
    return Transition(zeta, bitcast<i32>(u), bitcast<i32>(v), bitcast<i32>(q), bitcast<i32>(r));
}

fn f_inv(a: F) -> F {
    let reduced = f_canonical(a);
    var f: S;
    var g: S;
    var d: S;
    var e: S;
    for (var i = 0u; i < 20u; i++) {
        f[i] = i32(P13[i]);
        g[i] = i32(reduced[i]);
    }
    e[0] = 1;
    var zeta = -1;
    for (var batch = 0u; batch < 46u; batch++) {
        let t = divsteps13(zeta, u32(f[0]), u32(g[0]));
        zeta = t.zeta;
        // [d, e] = (t·[d, e] + p·[md, me]) / 2^13, with md and me making the division exact and
        // keeping the results within (−2p, p). Written out limb by limb so the limbs stay in
        // registers rather than indexed arrays.
        let sd = d[19] >> 31u;
        let se = e[19] >> 31u;
        var md = (t.u & sd) + (t.v & se);
        var me = (t.q & sd) + (t.r & se);
        var cd = t.u * d[0] + t.v * e[0];
        var ce = t.q * d[0] + t.r * e[0];
        md -= bitcast<i32>((P_INV13 * bitcast<u32>(cd) + bitcast<u32>(md)) & 0x1fffu);
        me -= bitcast<i32>((P_INV13 * bitcast<u32>(ce) + bitcast<u32>(me)) & 0x1fffu);
        cd = (cd + 7215 * md) >> 13u;
        ce = (ce + 7215 * me) >> 13u;
        cd += t.u * d[1] + t.v * e[1] + 8191 * md;
        ce += t.q * d[1] + t.r * e[1] + 8191 * me;
        d[0] = cd & S_MASK; cd >>= 13u; e[0] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[2] + t.v * e[2] + 8127 * md;
        ce += t.q * d[2] + t.r * e[2] + 8127 * me;
        d[1] = cd & S_MASK; cd >>= 13u; e[1] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[3] + t.v * e[3] + 8191 * md;
        ce += t.q * d[3] + t.r * e[3] + 8191 * me;
        d[2] = cd & S_MASK; cd >>= 13u; e[2] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[4] + t.v * e[4] + 8191 * md;
        ce += t.q * d[4] + t.r * e[4] + 8191 * me;
        d[3] = cd & S_MASK; cd >>= 13u; e[3] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[5] + t.v * e[5] + 8191 * md;
        ce += t.q * d[5] + t.r * e[5] + 8191 * me;
        d[4] = cd & S_MASK; cd >>= 13u; e[4] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[6] + t.v * e[6] + 8191 * md;
        ce += t.q * d[6] + t.r * e[6] + 8191 * me;
        d[5] = cd & S_MASK; cd >>= 13u; e[5] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[7] + t.v * e[7] + 8191 * md;
        ce += t.q * d[7] + t.r * e[7] + 8191 * me;
        d[6] = cd & S_MASK; cd >>= 13u; e[6] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[8] + t.v * e[8] + 8191 * md;
        ce += t.q * d[8] + t.r * e[8] + 8191 * me;
        d[7] = cd & S_MASK; cd >>= 13u; e[7] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[9] + t.v * e[9] + 8191 * md;
        ce += t.q * d[9] + t.r * e[9] + 8191 * me;
        d[8] = cd & S_MASK; cd >>= 13u; e[8] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[10] + t.v * e[10] + 8191 * md;
        ce += t.q * d[10] + t.r * e[10] + 8191 * me;
        d[9] = cd & S_MASK; cd >>= 13u; e[9] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[11] + t.v * e[11] + 8191 * md;
        ce += t.q * d[11] + t.r * e[11] + 8191 * me;
        d[10] = cd & S_MASK; cd >>= 13u; e[10] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[12] + t.v * e[12] + 8191 * md;
        ce += t.q * d[12] + t.r * e[12] + 8191 * me;
        d[11] = cd & S_MASK; cd >>= 13u; e[11] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[13] + t.v * e[13] + 8191 * md;
        ce += t.q * d[13] + t.r * e[13] + 8191 * me;
        d[12] = cd & S_MASK; cd >>= 13u; e[12] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[14] + t.v * e[14] + 8191 * md;
        ce += t.q * d[14] + t.r * e[14] + 8191 * me;
        d[13] = cd & S_MASK; cd >>= 13u; e[13] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[15] + t.v * e[15] + 8191 * md;
        ce += t.q * d[15] + t.r * e[15] + 8191 * me;
        d[14] = cd & S_MASK; cd >>= 13u; e[14] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[16] + t.v * e[16] + 8191 * md;
        ce += t.q * d[16] + t.r * e[16] + 8191 * me;
        d[15] = cd & S_MASK; cd >>= 13u; e[15] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[17] + t.v * e[17] + 8191 * md;
        ce += t.q * d[17] + t.r * e[17] + 8191 * me;
        d[16] = cd & S_MASK; cd >>= 13u; e[16] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[18] + t.v * e[18] + 8191 * md;
        ce += t.q * d[18] + t.r * e[18] + 8191 * me;
        d[17] = cd & S_MASK; cd >>= 13u; e[17] = ce & S_MASK; ce >>= 13u;
        cd += t.u * d[19] + t.v * e[19] + 511 * md;
        ce += t.q * d[19] + t.r * e[19] + 511 * me;
        d[18] = cd & S_MASK; cd >>= 13u; e[18] = ce & S_MASK; ce >>= 13u;
        d[19] = cd;
        e[19] = ce;
        // [f, g] = t·[f, g] / 2^13, exactly.
        var cf = (t.u * f[0] + t.v * g[0]) >> 13u;
        var cg = (t.q * f[0] + t.r * g[0]) >> 13u;
        cf += t.u * f[1] + t.v * g[1];
        cg += t.q * f[1] + t.r * g[1];
        f[0] = cf & S_MASK; cf >>= 13u; g[0] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[2] + t.v * g[2];
        cg += t.q * f[2] + t.r * g[2];
        f[1] = cf & S_MASK; cf >>= 13u; g[1] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[3] + t.v * g[3];
        cg += t.q * f[3] + t.r * g[3];
        f[2] = cf & S_MASK; cf >>= 13u; g[2] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[4] + t.v * g[4];
        cg += t.q * f[4] + t.r * g[4];
        f[3] = cf & S_MASK; cf >>= 13u; g[3] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[5] + t.v * g[5];
        cg += t.q * f[5] + t.r * g[5];
        f[4] = cf & S_MASK; cf >>= 13u; g[4] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[6] + t.v * g[6];
        cg += t.q * f[6] + t.r * g[6];
        f[5] = cf & S_MASK; cf >>= 13u; g[5] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[7] + t.v * g[7];
        cg += t.q * f[7] + t.r * g[7];
        f[6] = cf & S_MASK; cf >>= 13u; g[6] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[8] + t.v * g[8];
        cg += t.q * f[8] + t.r * g[8];
        f[7] = cf & S_MASK; cf >>= 13u; g[7] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[9] + t.v * g[9];
        cg += t.q * f[9] + t.r * g[9];
        f[8] = cf & S_MASK; cf >>= 13u; g[8] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[10] + t.v * g[10];
        cg += t.q * f[10] + t.r * g[10];
        f[9] = cf & S_MASK; cf >>= 13u; g[9] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[11] + t.v * g[11];
        cg += t.q * f[11] + t.r * g[11];
        f[10] = cf & S_MASK; cf >>= 13u; g[10] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[12] + t.v * g[12];
        cg += t.q * f[12] + t.r * g[12];
        f[11] = cf & S_MASK; cf >>= 13u; g[11] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[13] + t.v * g[13];
        cg += t.q * f[13] + t.r * g[13];
        f[12] = cf & S_MASK; cf >>= 13u; g[12] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[14] + t.v * g[14];
        cg += t.q * f[14] + t.r * g[14];
        f[13] = cf & S_MASK; cf >>= 13u; g[13] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[15] + t.v * g[15];
        cg += t.q * f[15] + t.r * g[15];
        f[14] = cf & S_MASK; cf >>= 13u; g[14] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[16] + t.v * g[16];
        cg += t.q * f[16] + t.r * g[16];
        f[15] = cf & S_MASK; cf >>= 13u; g[15] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[17] + t.v * g[17];
        cg += t.q * f[17] + t.r * g[17];
        f[16] = cf & S_MASK; cf >>= 13u; g[16] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[18] + t.v * g[18];
        cg += t.q * f[18] + t.r * g[18];
        f[17] = cf & S_MASK; cf >>= 13u; g[17] = cg & S_MASK; cg >>= 13u;
        cf += t.u * f[19] + t.v * g[19];
        cg += t.q * f[19] + t.r * g[19];
        f[18] = cf & S_MASK; cf >>= 13u; g[18] = cg & S_MASK; cg >>= 13u;
        f[19] = cf;
        g[19] = cg;
    }
    // f = ±1, and the inverse is d·f: negate d when f is −1, then add 2p if it is negative.
    let negative = f[19] < 0;
    var carry = 0;
    for (var i = 0u; i < 20u; i++) {
        let value = select(d[i], -d[i], negative) + carry;
        d[i] = select(value & S_MASK, value, i == 19u);
        carry = value >> 13u;
    }
    let add = select(0, 2, d[19] < 0);
    carry = 0;
    var out: F;
    for (var i = 0u; i < 20u; i++) {
        let value = d[i] + add * i32(P13[i]) + carry;
        out[i] = u32(select(value & S_MASK, value, i == 19u));
        carry = value >> 13u;
    }
    return out;
}

// The unique representative below p, written out limb by limb.
fn f_canonical(a: F) -> F {
    var r = a;
    var v: u32;
    var top: u32;
    // Bits 256..259 sit in limb 19 above bit 9: fold them with 2^256 ≡ 2^32 + 977, twice in
    // case the first fold carries back up.
    top = r[19] >> 9u;
    r[19] &= 0x1ffu;
    r[0] += top * 977u;
    r[2] += top * 64u;
    v = r[0]; r[0] = v & LIMB_MASK;
    v = r[1] + (v >> 13u); r[1] = v & LIMB_MASK;
    v = r[2] + (v >> 13u); r[2] = v & LIMB_MASK;
    v = r[3] + (v >> 13u); r[3] = v & LIMB_MASK;
    v = r[4] + (v >> 13u); r[4] = v & LIMB_MASK;
    v = r[5] + (v >> 13u); r[5] = v & LIMB_MASK;
    v = r[6] + (v >> 13u); r[6] = v & LIMB_MASK;
    v = r[7] + (v >> 13u); r[7] = v & LIMB_MASK;
    v = r[8] + (v >> 13u); r[8] = v & LIMB_MASK;
    v = r[9] + (v >> 13u); r[9] = v & LIMB_MASK;
    v = r[10] + (v >> 13u); r[10] = v & LIMB_MASK;
    v = r[11] + (v >> 13u); r[11] = v & LIMB_MASK;
    v = r[12] + (v >> 13u); r[12] = v & LIMB_MASK;
    v = r[13] + (v >> 13u); r[13] = v & LIMB_MASK;
    v = r[14] + (v >> 13u); r[14] = v & LIMB_MASK;
    v = r[15] + (v >> 13u); r[15] = v & LIMB_MASK;
    v = r[16] + (v >> 13u); r[16] = v & LIMB_MASK;
    v = r[17] + (v >> 13u); r[17] = v & LIMB_MASK;
    v = r[18] + (v >> 13u); r[18] = v & LIMB_MASK;
    v = r[19] + (v >> 13u); r[19] = v & LIMB_MASK;
    top = r[19] >> 9u;
    r[19] &= 0x1ffu;
    r[0] += top * 977u;
    r[2] += top * 64u;
    v = r[0]; r[0] = v & LIMB_MASK;
    v = r[1] + (v >> 13u); r[1] = v & LIMB_MASK;
    v = r[2] + (v >> 13u); r[2] = v & LIMB_MASK;
    v = r[3] + (v >> 13u); r[3] = v & LIMB_MASK;
    v = r[4] + (v >> 13u); r[4] = v & LIMB_MASK;
    v = r[5] + (v >> 13u); r[5] = v & LIMB_MASK;
    v = r[6] + (v >> 13u); r[6] = v & LIMB_MASK;
    v = r[7] + (v >> 13u); r[7] = v & LIMB_MASK;
    v = r[8] + (v >> 13u); r[8] = v & LIMB_MASK;
    v = r[9] + (v >> 13u); r[9] = v & LIMB_MASK;
    v = r[10] + (v >> 13u); r[10] = v & LIMB_MASK;
    v = r[11] + (v >> 13u); r[11] = v & LIMB_MASK;
    v = r[12] + (v >> 13u); r[12] = v & LIMB_MASK;
    v = r[13] + (v >> 13u); r[13] = v & LIMB_MASK;
    v = r[14] + (v >> 13u); r[14] = v & LIMB_MASK;
    v = r[15] + (v >> 13u); r[15] = v & LIMB_MASK;
    v = r[16] + (v >> 13u); r[16] = v & LIMB_MASK;
    v = r[17] + (v >> 13u); r[17] = v & LIMB_MASK;
    v = r[18] + (v >> 13u); r[18] = v & LIMB_MASK;
    v = r[19] + (v >> 13u); r[19] = v & LIMB_MASK;
    // Now r < 2^256 < 2p: subtract p once if r >= p, choosing limb by limb.
    var t: F;
    var borrow = 0u;
    v = r[0] + 8192u - 7215u - borrow; t[0] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[1] + 8192u - 8191u - borrow; t[1] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[2] + 8192u - 8127u - borrow; t[2] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[3] + 8192u - 8191u - borrow; t[3] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[4] + 8192u - 8191u - borrow; t[4] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[5] + 8192u - 8191u - borrow; t[5] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[6] + 8192u - 8191u - borrow; t[6] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[7] + 8192u - 8191u - borrow; t[7] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[8] + 8192u - 8191u - borrow; t[8] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[9] + 8192u - 8191u - borrow; t[9] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[10] + 8192u - 8191u - borrow; t[10] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[11] + 8192u - 8191u - borrow; t[11] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[12] + 8192u - 8191u - borrow; t[12] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[13] + 8192u - 8191u - borrow; t[13] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[14] + 8192u - 8191u - borrow; t[14] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[15] + 8192u - 8191u - borrow; t[15] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[16] + 8192u - 8191u - borrow; t[16] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[17] + 8192u - 8191u - borrow; t[17] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[18] + 8192u - 8191u - borrow; t[18] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    v = r[19] + 8192u - 511u - borrow; t[19] = v & LIMB_MASK; borrow = 1u - (v >> 13u);
    let below = borrow == 1u;
    for (var i = 0u; i < 20u; i++) {
        r[i] = select(t[i], r[i], below);
    }
    return r;
}


fn fe_to_f(a: Fe) -> F {
    var r: F;
    for (var i = 0u; i < 20u; i++) {
        let bit = 13u * i;
        let word = bit / 32u;
        let shift = bit % 32u;
        var v = a[word] >> shift;
        if shift > 19u && word < 7u {
            v |= a[word + 1u] << (32u - shift);
        }
        r[i] = v & LIMB_MASK;
    }
    return r;
}

// A canonical element back to 8 little-endian 32-bit limbs.
fn f_to_fe(a: F) -> Fe {
    var r: Fe;
    for (var i = 0u; i < 20u; i++) {
        let bit = 13u * i;
        let word = bit / 32u;
        let shift = bit % 32u;
        r[word] |= a[i] << shift;
        if shift > 19u && word < 7u {
            r[word + 1u] |= a[i] >> (32u - shift);
        }
    }
    return r;
}

fn f_one() -> F {
    var r: F;
    r[0] = 1u;
    return r;
}

fn jac_from_affine(q: AffF) -> JacF {
    return JacF(q.x, q.y, f_one(), q.infinity);
}

// Jacobian plus affine (madd-2007-bl) without the P = ±Q cases, which need two full reductions per addition
// and happen with probability about 2^-256 here. If one ever did, that candidate's output would
// be wrong, and the host re-derives every match with the library code before trusting it.
fn jac_add_affine(p: JacF, q: AffF) -> JacF {
    if q.infinity {
        return p;
    }
    if p.infinity {
        return jac_from_affine(q);
    }
    // Ordered to end each value's life early: Z3 right after HH frees Z1 and Z1Z1, and every
    // field element held is 20 registers.
    let z1z1 = f_sqr(p.z);
    let s2 = f_mul(q.y, f_mul(p.z, z1z1));
    let h = f_sub(f_mul(q.x, z1z1), p.x);
    let z1h = f_mul(p.z, h);
    let z3 = f_add(z1h, z1h);
    let hh = f_sqr(h);
    let i = f_times4(hh);
    let j = f_mul(h, i);
    let r = f_double_sub(s2, p.y);
    let v = f_mul(p.x, i);
    let x3 = f_sub_sub_double(f_sqr(r), j, v);
    let y1j = f_mul(p.y, j);
    let y3 = f_sub_double(f_mul(r, f_sub(v, x3)), y1j);
    return JacF(x3, y3, z3, false);
}

fn g_point_f(first: u32, digit: u32) -> AffF {
    let q = g_point(first, digit);
    return AffF(fe_to_f(q.x), fe_to_f(q.y), false);
}

// The digit of k's bits bit..bit + width as a magnitude and sign: those bits plus the carry from
// the window below, less 2^width (carrying one up) when above 2^(width − 1). The top window
// reaches past k's top bit, so it never carries out.
struct Digit {
    magnitude: u32,
    negative: bool,
    carry: u32,
}

fn signed_digit(k: Fe, bit: u32, width: u32, carry: u32) -> Digit {
    let d = window_digit(k, bit, width) + carry;
    if d > (1u << (width - 1u)) {
        return Digit((1u << width) - d, true, 1u);
    }
    return Digit(d, false, 0u);
}

// ±magnitude times the base of the window whose entries start at `first`; the magnitude must be
// nonzero.
fn g_point_signed(first: u32, digit: Digit) -> AffF {
    var q = g_point_f(first, digit.magnitude);
    if digit.negative {
        q.y = f_neg(q.y);
    }
    return q;
}

// A point in XYZZ coordinates: x = X/ZZ and y = Y/ZZZ, with ZZ³ = ZZZ².
struct XyzzF {
    x: F,
    y: F,
    zz: F,
    zzz: F,
}

// XYZZ plus affine (madd-2008-s, 8M + 2S), without the P = ±Q cases, as jac_add_affine.
fn xyzz_add_affine(p: XyzzF, q: AffF) -> XyzzF {
    let pp_base = f_sub(f_mul(q.x, p.zz), p.x);
    let r = f_sub(f_mul(q.y, p.zzz), p.y);
    let pp = f_sqr(pp_base);
    let ppp = f_mul(pp_base, pp);
    let zz3 = f_mul(p.zz, pp);
    let zzz3 = f_mul(p.zzz, ppp);
    let q_term = f_mul(p.x, pp);
    let x3 = f_sub_sub_double(f_sqr(r), ppp, q_term);
    let y3 = f_sub(f_mul(r, f_sub(q_term, x3)), f_mul(p.y, ppp));
    return XyzzF(x3, y3, zz3, zzz3);
}

// Affine plus affine into XYZZ (both ZZ = 1, 4M + 2S): madd-2008-s with U2 = X2, S2 = Y2,
// ZZ3 = PP and ZZZ3 = PPP.
fn affine_add_affine_xyzz(p: AffF, q: AffF) -> XyzzF {
    let pp_base = f_sub(q.x, p.x);
    let r = f_sub(q.y, p.y);
    let pp = f_sqr(pp_base);
    let ppp = f_mul(pp_base, pp);
    let q_term = f_mul(p.x, pp);
    let x3 = f_sub_sub_double(f_sqr(r), ppp, q_term);
    let y3 = f_sub(f_mul(r, f_sub(q_term, x3)), f_mul(p.y, ppp));
    return XyzzF(x3, y3, pp, ppp);
}

// start + k·G from the generator table's windows, with window 0's carry: one mixed addition per
// nonzero window, in XYZZ coordinates; the first from the affine start.
fn xyzz_add_mul_g(start: AffF, k: Fe, carry_in: u32) -> XyzzF {
    let one = f_one();
    var acc = XyzzF(start.x, start.y, one, one);
    let window1 = signed_digit(k, Q_BITS, G_WIDTH + 1u, carry_in);
    if window1.magnitude != 0u {
        acc = affine_add_affine_xyzz(start, g_point_signed(0u, window1));
    }
    var carry = window1.carry;
    var shift = Q_BITS + G_WIDTH + 1u;
    var first = 1u << G_WIDTH;
    for (var w = 1u; w < G_WINDOWS; w++) {
        let width = select(G_WIDTH, G_WIDTH + 1u, w < G_WIDE);
        let digit = signed_digit(k, shift, width, carry);
        carry = digit.carry;
        if digit.magnitude != 0u {
            acc = xyzz_add_affine(acc, g_point_signed(first, digit));
        }
        shift += width;
        first += 1u << (width - 1u);
    }
    return acc;
}

// Field self-test: for each case, two normalized inputs a and b (20 limbs each) from params
// after a count word; writes canonical a·b, a², a+b, a−b, −a, 1/a and a to debug_out.
@compute @workgroup_size(64)
fn field_test(@builtin(global_invocation_id) id: vec3<u32>) {
    if id.x >= params[0] {
        return;
    }
    var a: F;
    var b: F;
    for (var i = 0u; i < 20u; i++) {
        a[i] = params[1u + id.x * 40u + i];
        b[i] = params[21u + id.x * 40u + i];
    }
    var results: array<Fe, 7>;
    results[0] = f_to_fe(f_canonical(f_mul(a, b)));
    results[1] = f_to_fe(f_canonical(f_sqr(a)));
    results[2] = f_to_fe(f_canonical(f_add(a, b)));
    results[3] = f_to_fe(f_canonical(f_sub(a, b)));
    results[4] = f_to_fe(f_canonical(f_neg(a)));
    results[5] = f_to_fe(f_canonical(f_inv(a)));
    results[6] = f_to_fe(f_canonical(a));
    for (var op = 0u; op < 7u; op++) {
        for (var w = 0u; w < 8u; w++) {
            debug_out[id.x * 56u + op * 8u + w] = results[op][w];
        }
    }
}
