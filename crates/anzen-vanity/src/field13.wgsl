fn f_to_fe(a: F) -> Fe {
    var r: Fe;
    for (var i = 0u; i < 20u; i++) {
        let bit = 13u * i;
        let word = bit / 32u;
        let shift = bit % 32u;
        r[word] |= a[i] << shift;
        if shift > 19u && word < 7u {
            r[word + 1u] |= a[i] >> (32u - shift);
