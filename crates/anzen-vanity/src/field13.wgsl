}

fn fe_to_f(a: Fe) -> F {
    var r: F;
    for (var i = 0u; i < 20u; i++) {
        let bit = 13u * i;
        let word = bit / 32u;
        let shift = bit % 32u;
        var v = a[word] >> shift;
        if shift > 19u && word < 7u {
            v |= a[word + 1u] << (32u - shift);
        }
        r[i] = v & LIMB_MASK;
    }
    return r;
}

// A canonical element back to 8 little-endian 32-bit limbs.
fn f_to_fe(a: F) -> Fe {
    var r: Fe;
    for (var i = 0u; i < 20u; i++) {
        let bit = 13u * i;
        let word = bit / 32u;
        let shift = bit % 32u;
        r[word] |= a[i] << shift;
        if shift > 19u && word < 7u {
            r[word + 1u] |= a[i] >> (32u - shift);
        }
    }
    return r;
}

fn f_one() -> F {
    var r: F;
    r[0] = 1u;
    return r;
}

fn jac_from_affine(q: AffF) -> JacF {
    return JacF(q.x, q.y, f_one(), q.infinity);
}

// Jacobian plus affine (madd-2007-bl) without the P = ±Q cases, which need two full reductions per addition
// and happen with probability about 2^-256 here. If one ever did, that candidate's output would
// be wrong, and the host re-derives every match with the library code before trusting it.
fn jac_add_affine(p: JacF, q: AffF) -> JacF {
    if q.infinity {
        return p;
    }
    if p.infinity {
        return jac_from_affine(q);
    }
    // Ordered to end each value's life early: Z3 right after HH frees Z1 and Z1Z1, and every
    // field element held is 20 registers.
    let z1z1 = f_sqr(p.z);
    let s2 = f_mul(q.y, f_mul(p.z, z1z1));
    let h = f_sub(f_mul(q.x, z1z1), p.x);
    let z1h = f_mul(p.z, h);
    let z3 = f_add(z1h, z1h);
    let hh = f_sqr(h);
    let s_diff = f_sub(s2, p.y);
    var i = f_add(hh, hh);
    i = f_add(i, i);
    let j = f_mul(h, i);
    let r = f_add(s_diff, s_diff);
    let v = f_mul(p.x, i);
    let x3 = f_sub(f_sub(f_sqr(r), j), f_add(v, v));
    let y1j = f_mul(p.y, j);
    let y3 = f_sub(f_mul(r, f_sub(v, x3)), f_add(y1j, y1j));
    return JacF(x3, y3, z3, false);
}

fn g_point_f(window: u32, digit: u32) -> AffF {
    let q = g_point(window, digit);
    return AffF(fe_to_f(q.x), fe_to_f(q.y), false);
}

// Window w's digit of k as a magnitude and sign: its bits plus the carry from the window below,
// less 2^G_WINDOW_BITS (carrying one up) when above G_DIGITS. The top window holds only k's top
// bits, so it never carries out.
struct Digit {
    magnitude: u32,
    negative: bool,
    carry: u32,
}

fn signed_digit(k: Fe, w: u32, carry: u32) -> Digit {
    let d = window_digit(k, w * G_WINDOW_BITS, G_WINDOW_BITS) + carry;
    if d > G_DIGITS {
        return Digit((1u << G_WINDOW_BITS) - d, true, 1u);
    }
    return Digit(d, false, 0u);
}

// ±(magnitude·2^(G_WINDOW_BITS·w))·G; the magnitude must be nonzero.
fn g_point_signed(w: u32, digit: Digit) -> AffF {
    var q = g_point_f(w, digit.magnitude);
    if digit.negative {
        q.y = f_neg(q.y);
    }
    return q;
}

// acc + k·G from the table from window 1 up, with window 0's carry: one mixed addition per
// nonzero window.
fn jac_add_mul_g(start: JacF, k: Fe, carry_in: u32) -> JacF {
    var acc = start;
    var carry = carry_in;
    for (var w = 1u; w < G_WINDOWS; w++) {
        let digit = signed_digit(k, w, carry);
        carry = digit.carry;
        if digit.magnitude != 0u {
            acc = jac_add_affine(acc, g_point_signed(w, digit));
        }
    }
    return acc;
}

// Field self-test: for each case, two normalized inputs a and b (20 limbs each) from params
// after a count word; writes canonical a·b, a², a+b, a−b, −a, 1/a and a to debug_out.
@compute @workgroup_size(64)
fn field_test(@builtin(global_invocation_id) id: vec3<u32>) {
    if id.x >= params[0] {
        return;
    }
    var a: F;
    var b: F;
    for (var i = 0u; i < 20u; i++) {
        a[i] = params[1u + id.x * 40u + i];
        b[i] = params[21u + id.x * 40u + i];
    }
    var results: array<Fe, 7>;
    results[0] = f_to_fe(f_canonical(f_mul(a, b)));
    results[1] = f_to_fe(f_canonical(f_sqr(a)));
    results[2] = f_to_fe(f_canonical(f_add(a, b)));
    results[3] = f_to_fe(f_canonical(f_sub(a, b)));
    results[4] = f_to_fe(f_canonical(f_neg(a)));
    results[5] = f_to_fe(f_canonical(f_inv(a)));
    results[6] = f_to_fe(f_canonical(a));
    for (var op = 0u; op < 7u; op++) {
        for (var w = 0u; w < 8u; w++) {
            debug_out[id.x * 56u + op * 8u + w] = results[op][w];
        }
    }
}
