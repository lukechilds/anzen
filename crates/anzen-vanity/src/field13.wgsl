    c8 = f_add(c8, c8);
    c8 = f_add(c8, c8);
    let y3 = f_sub(f_mul(e, f_sub(d, x3)), c8);
    let yz = f_mul(p.y, p.z);
    return JacF(x3, y3, f_add(yz, yz), false);
