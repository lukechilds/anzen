// Jacobian plus affine (madd-2007-bl), with the special cases.
fn jac_add_affine(p: JacF, q: AffF) -> JacF {
    if q.infinity {
        return p;
    }
    if p.infinity {
        return jac_from_affine(q);
    }
    let z1z1 = f_sqr(p.z);
    let u2 = f_mul(q.x, z1z1);
    let s2 = f_mul(q.y, f_mul(p.z, z1z1));
    let h = f_sub(u2, p.x);
    let s_diff = f_sub(s2, p.y);
    if f_is_zero(h) {
        if f_is_zero(s_diff) {
            return jac_double(p);
        }
        return jac_infinity();
