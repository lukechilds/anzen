fn fe_to_f(a: Fe) -> F {
    var r: F;
    for (var i = 0u; i < 20u; i++) {
        let bit = 13u * i;
        let word = bit / 32u;
        let shift = bit % 32u;
        var v = a[word] >> shift;
        if shift > 19u && word < 7u {
            v |= a[word + 1u] << (32u - shift);
